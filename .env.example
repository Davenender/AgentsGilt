# Vorlage: Alle Einstellungen, die die Website und der Bot kennen. Die echten Werte stehen nur bei Vercel
# (Settings, Environment Variables) und lokal in .env.local, NIE im Code oder in diesem Repository.
# "Pflicht" heißt: Ohne den Wert fehlt die Funktion (der Rest läuft weiter).

# --- KI (Anthropic): Website-Chatbot, Zusammenfassungen, Spam-Prüfung, Lead-Analyse
ANTHROPIC_API_KEY=

# --- Mail (Resend)
RESEND_API_KEY=
MAIL_FROM=Agents Gilt <kontakt@agentsgilt.com>
MAIL_TO=kontakt@agentsgilt.com

# --- Discord-Bot (Pflicht für alle Karten und Knöpfe)
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ANRUFE=
# optional: Server-ID (Standard steht im Code), Webhook als Ersatz ohne Bot
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_ANRUFE=

# --- Telefon-Assistent (Vapi)
VAPI_SECRET=
VAPI_API_KEY=
VAPI_RUECKRUF_ASSISTANT=
# optional: Absendernummer in Vapi (Standard steht im Code), SIP-Adresse des Hauptassistenten
VAPI_NUMBER_ID=
VAPI_SIP_URI=

# --- Twilio (SMS, Rufgruppe, Rückruf-Weiche)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Rufgruppe: Handynummern, durch Komma getrennt (zweite Variable für weitere Nummern)
RUFGRUPPE_NUMMERN=
RUFGRUPPE_NUMMERN_2=
# optional: z. B. "Mo-Fr 15:00-20:00; Sa-So 10:00-18:00" (leer = immer), Klingeldauer, Nummern
RUFGRUPPE_ZEITEN=
RUFGRUPPE_SEKUNDEN=
RUFGRUPPE_ABSENDER=
RUFGRUPPE_EINGANG=

# --- Links in SMS und Support-Chat (Schlüssel zum Signieren; ohne Wert wird der Bot-Token genutzt)
LINK_SECRET=
SITE_URL=https://agentsgilt.com

# --- Google: Kalender (Dienstkonto) und Karten/Orte für die Lead-Suche
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_PLACES_KEY=

# --- Notion (Kunden-Datenbank)
NOTION_TOKEN=
NOTION_WEBHOOK_KEY=
# optional: ID der Kunden-Datenbank (Standard steht im Code)
NOTION_KUNDEN_DB=

# --- Push aufs Handy (ntfy): langes Zufallswort als Sender, optional eigener Server
NTFY_TOPIC=
NTFY_SERVER=

# --- Gmail-Brücke (Google-Skript): gemeinsames Geheimwort und Web-App-Adresse des Skripts
MAIL_BRIDGE_SECRET=
MAIL_SCRIPT_URL=
